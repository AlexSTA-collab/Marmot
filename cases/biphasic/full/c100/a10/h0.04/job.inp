*node
** Our  nodes
**
*include, input=@IJES_ROOT@/meshes/S_mesh/angle_10/height_0.04/include_nodes.inp
********************************** E L E M E N T S ****************************
*element, type=C3D8, provider=marmot, elset=bottom-body
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_10/height_0.04/include_elset_bottom.inp

*element, type=YIQUAD4_BIPHASIC, provider=marmot, elset=interface-body
*include, input=@IJES_ROOT@/meshes/S_mesh/angle_10/height_0.04/include_elset_interface.inp

*element, type=C3D8, provider=marmot, elset=top-body
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_10/height_0.04/include_elset_top.inp

********************************** N O D E S E T S **********************************
*NSET, NSET=bottom-Z+
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_10/height_0.04/include_nset_bottom-Z+.inp
*NSET, NSET=bottom-Y+
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_10/height_0.04/include_nset_bottom-Y+.inp
*NSET, NSET=bottom-X+
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_10/height_0.04/include_nset_bottom-X+.inp
*NSET, NSET=bottom-Z-
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_10/height_0.04/include_nset_bottom-Z-.inp
*NSET, NSET=bottom-Y-
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_10/height_0.04/include_nset_bottom-Y-.inp
*NSET, NSET=bottom-X-
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_10/height_0.04/include_nset_bottom-X-.inp
*NSET, NSET=top-Z-
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_10/height_0.04/include_nset_top-Z-.inp
*NSET, NSET=top-Y+
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_10/height_0.04/include_nset_top-Y+.inp
*NSET, NSET=top-X-
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_10/height_0.04/include_nset_top-X-.inp
*NSET, NSET=top-Z+
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_10/height_0.04/include_nset_top-Z+.inp
*NSET, NSET=top-Y-
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_10/height_0.04/include_nset_top-Y-.inp
*NSET, NSET=top-X+
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_10/height_0.04/include_nset_top-X+.inp

*material, name=LinearElastic, id=linearelastic_body_1, provider=marmotmaterial
**Isotropic
**E_M    nu
 2e5, 0.3


*material, name=LinearElastic, id=linearelastic_body_2, provider=marmotmaterial
**Isotropic
**E_I    nu
 4e3, 0.3


*material, name=LINEARELASTIC, id=ElasticInterfaceMaterial, provider = marmotmaterialhypoelasticinterface
 **Isotropic
** E_0, nu_0,   h_normal, MaterialID
 400000, 0.3, 0.03939231012048832, 0, 4000, 0.3

*section, name=section1, material=linearelastic_body_2, type=solid
bottom-body

*section, name=section2, material=linearelastic_body_1, type=solid
top-body

*section, name=section3, material=ElasticInterfaceMaterial, type=solid
interface-body

*job, name=InterfaceModel_job, domain=3d
*solver, solver=NISTParallel, name=theSolver

*fieldOutput
>>perNode, elSet=top-body, field=displacement, result=U, name=displacement_top
>>perNode, elSet=top-body, field=displacement, result=P, name=reaction_top
>>perNode, elSet=bottom-body, field=displacement, result=U, name=displacement_bottom
>>perNode, elSet=bottom-body, field=displacement, result=P, name=reaction_bottom
>>perNode, elSet=interface-body, field=displacement, result=U, name=displacement_interface
>>perElement, elSet=top-body, quadraturePoint=0:8, result=stress , name=stress_top, f(x)='np.mean(x,axis=1)' 
>>perElement, elSet=bottom-body, quadraturePoint=0:8, result=stress , name=stress_bottom, f(x)='np.mean(x,axis=1)' 

>>perElement, elSet=interface-body, quadraturePoint=0:4, result=generalizedForce , name=force_interface, f(x)='np.mean(x,axis=1)' 
>>perElement, elSet=interface-body, quadraturePoint=0:4, result=surfaceStressPlus , name=surface_stress_interface, f(x)='np.mean(x,axis=1)' 

*output, type=ensight, name=Cohesive_zone_model_interface_0.04
>>perNode, fieldOutput=displacement_interface
>>perElement, fieldOutput=force_interface
>>perElement, fieldOutput=surface_stress_interface
>>configuration, overwrite=yes

*output, type=ensight, name=Cohesive_zone_model_top_0.04
>>perNode, fieldOutput=displacement_top
>>perNode,  fieldOutput=reaction_top
>>perElement, fieldOutput=stress_top
>>configuration, overwrite=yes

*output, type=ensight, name=Cohesive_zone_model_bottom_0.04
>>perNode,  fieldOutput=displacement_bottom
>>perNode,  fieldOutput=reaction_bottom
>>perElement, fieldOutput=stress_bottom
>>configuration, overwrite=yes

*step, solver=theSolver
maxInc=1, minInc=1, maxNumInc=1000, maxIter=1000, stepLength=1.0
>>options, name=theSolver, extrapolation=off
>>dirichlet, name = bottom,   nSet = bottom-Z-,  field=displacement, 1=0., 2=0, 3=0, f(t)=t
**nodeforces, name = topF,      nSet = top-Z+,  field=displacement, 1=1e-6, 2=0, 3=0, f(t)=t
>>dirichlet, name = top,      nSet = top-Z+,  field=displacement, 1=1e-2, 2=0, 3=0, f(t)=t
>>dirichlet, name = bottom-LX,   nSet = bottom-X-,  field=displacement, 2=0, 3=0, f(t)=t
>>dirichlet, name = bottom-RX,   nSet = bottom-X+,  field=displacement, 2=0, 3=0, f(t)=t
>>dirichlet, name = bottom-FY,   nSet = bottom-Y-,  field=displacement, 2=0, 3=0, f(t)=t
>>dirichlet, name = bottom-BY,   nSet = bottom-Y+,  field=displacement, 2=0, 3=0, f(t)=t
>>dirichlet, name = top-LX,   nSet = top-X-,  field=displacement, 2=0, 3=0, f(t)=t
>>dirichlet, name = top-RX,   nSet = top-X+,  field=displacement, 2=0, 3=0, f(t)=t
>>dirichlet, name = top-FY,   nSet = top-Y-,  field=displacement, 2=0, 3=0, f(t)=t
>>dirichlet, name = top-BY,   nSet = top-Y+,  field=displacement, 2=0, 3=0, f(t)=t

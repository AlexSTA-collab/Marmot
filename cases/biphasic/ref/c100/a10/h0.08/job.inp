>>perElement, fieldOutput=stress_layer_top
>>configuration, overwrite=yes
*step, solver=theSolver
maxInc=1, minInc=1, maxNumInc=1000, maxIter=1000, stepLength=1.0
>>options, name=theSolver, extrapolation=off

*node
** Our  nodes
**
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.04/include_nodes.inp
********************************** E L E M E N T S ****************************
*element, type=C3D8, provider=marmot, elset=bottom-body
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.04/include_elset_bottom.inp

*element, type=C3D8B, provider=marmot, elset=interface-body
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.04/include_elset_interface.inp

*element, type=C3D8, provider=marmot, elset=top-body
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.04/include_elset_top.inp

********************************** N O D E S E T S **********************************
*NSET, NSET=bottom-Z+
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.04/include_nset_bottom-Z+.inp
*NSET, NSET=bottom-Y+
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.04/include_nset_bottom-Y+.inp
*NSET, NSET=bottom-X+
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.04/include_nset_bottom-X+.inp
*NSET, NSET=bottom-Z-
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.04/include_nset_bottom-Z-.inp
*NSET, NSET=bottom-Y-
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.04/include_nset_bottom-Y-.inp
*NSET, NSET=bottom-X-
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.04/include_nset_bottom-X-.inp
*NSET, NSET=top-Z-
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.04/include_nset_top-Z-.inp
*NSET, NSET=top-Y+
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.04/include_nset_top-Y+.inp
*NSET, NSET=top-X-
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.04/include_nset_top-X-.inp
*NSET, NSET=top-Z+
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.04/include_nset_top-Z+.inp
*NSET, NSET=top-Y-
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.04/include_nset_top-Y-.inp
*NSET, NSET=top-X+
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.04/include_nset_top-X+.inp
*NSET, NSET=interphase-Z-
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.04/include_nset_interphase-Z-.inp
*NSET, NSET=interphase-Y+
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.04/include_nset_interphase-Y+.inp
*NSET, NSET=interphase-X-
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.04/include_nset_interphase-X-.inp
*NSET, NSET=interphase-Z+
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.04/include_nset_interphase-Z+.inp
*NSET, NSET=interphase-Y-
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.04/include_nset_interphase-Y-.inp
*NSET, NSET=interphase-X+
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.04/include_nset_interphase-X+.inp

*material, name=LinearElastic, id=linearelastic_body_1, provider=marmotmaterial
**Isotropic
**E_M    nu
 2e5, 0.3


*material, name=LinearElastic, id=linearelastic_body_2, provider=marmotmaterial
**Isotropic
**E_I    nu
 4e3, 0.3


*material, name=VONMISES, id=VonMisesMaterial, provider=marmotmaterial
 **Isotropic
** E_0, nu_0, fy, H, Aexp, Hexp
 4e3, 0.3, 5, 100, 0.0, 0.0

*section, name=section1, material=linearelastic_body_2, type=solid
bottom-body

*section, name=section2, material=linearelastic_body_1, type=solid
top-body

*section, name=section3, material=VonMisesMaterial, type=solid
interface-body

*constraint, type=inclinedrollermpc, name=lateral-roller
nSets=bottom-X-;bottom-X+;bottom-Y-;bottom-Y+;top-X-;top-X+;top-Y-;top-Y+;interphase-X-;interphase-X+;interphase-Y-;interphase-Y+
field=displacement
angle=0

*job, name=InterfaceModel_job, domain=3d
*solver, solver=NISTParallel, name=theSolver

*fieldOutput
>>perNode, elSet=top-body, field=displacement, result=U, name=displacement_top
>>perNode, elSet=top-body, field=displacement, result=P, name=reaction_top
>>perNode, elSet=bottom-body, field=displacement, result=U, name=displacement_bottom
>>perNode, elSet=bottom-body, field=displacement, result=P, name=reaction_bottom
>>perNode, elSet=interface-body, field=displacement, result=U, name=displacement_interface
>>perElement, elSet=top-body, quadraturePoint=0:8, result=stress , name=stress_top, f(x)='np.mean(x,axis=1)' 
>>perElement, elSet=bottom-body, quadraturePoint=0:8, result=stress , name=stress_bottom, f(x)='np.mean(x,axis=1)' 

>>perElement, elSet=interface-body, quadraturePoint=0:8, result=stress, name=stress_interface, f(x)='np.mean(x,axis=1)' 

*output, type=ensight, name=Cauchy_Full_model_interface_0.04
>>perNode, fieldOutput=displacement_interface
>>perElement, fieldOutput=stress_interface
>>configuration, overwrite=yes

*output, type=ensight, name=Cauchy_Full_model_top_0.04
>>perNode, fieldOutput=displacement_top
>>perNode,  fieldOutput=reaction_top
>>perElement, fieldOutput=stress_top
>>configuration, overwrite=yes

*output, type=ensight, name=Cauchy_Full_model_bottom_0.04
>>perNode,  fieldOutput=displacement_bottom
>>perNode,  fieldOutput=reaction_bottom
>>perElement, fieldOutput=stress_bottom
>>configuration, overwrite=yes

*step, solver=theSolver
maxInc=0.05, minInc=0.00001, maxNumInc=1000, maxIter=100000, stepLength=1.0
>>options, name=theSolver, extrapolation=linear
>>dirichlet, name = bottom,   nSet = bottom-Z-,  field=displacement, 1=0., 2=0, 3=0, f(t)=t
>>dirichlet, name = top,      nSet = top-Z+,  field=displacement, 1=0.01, 2=0, 3=0, f(t)=t

*node
** Our  nodes
**
*include, input=@IJES_ROOT@/meshes/if_L0/angle_10/height_0.01/include_nodes.inp
********************************** E L E M E N T S ****************************
*element, type=C3D8, provider=marmot, elset=bottom-body
*include, input=@IJES_ROOT@/meshes/if_L0/angle_10/height_0.01/include_elset_bottom.inp

*element, type=YIQUAD4, provider=marmot, elset=interface-body
*include, input=@IJES_ROOT@/meshes/if_L0/angle_10/height_0.01/include_elset_interface.inp

*element, type=C3D8, provider=marmot, elset=top-body
*include, input=@IJES_ROOT@/meshes/if_L0/angle_10/height_0.01/include_elset_top.inp

********************************** N O D E S E T S **********************************
*NSET, NSET=bottom-Z+
*include, input=@IJES_ROOT@/meshes/if_L0/angle_10/height_0.01/include_nset_bottom-Z+.inp
*NSET, NSET=bottom-Y+
*include, input=@IJES_ROOT@/meshes/if_L0/angle_10/height_0.01/include_nset_bottom-Y+.inp
*NSET, NSET=bottom-X+
*include, input=@IJES_ROOT@/meshes/if_L0/angle_10/height_0.01/include_nset_bottom-X+.inp
*NSET, NSET=bottom-Z-
*include, input=@IJES_ROOT@/meshes/if_L0/angle_10/height_0.01/include_nset_bottom-Z-.inp
*NSET, NSET=bottom-Y-
*include, input=@IJES_ROOT@/meshes/if_L0/angle_10/height_0.01/include_nset_bottom-Y-.inp
*NSET, NSET=bottom-X-
*include, input=@IJES_ROOT@/meshes/if_L0/angle_10/height_0.01/include_nset_bottom-X-.inp
*NSET, NSET=top-Z-
*include, input=@IJES_ROOT@/meshes/if_L0/angle_10/height_0.01/include_nset_top-Z-.inp
*NSET, NSET=top-Y+
*include, input=@IJES_ROOT@/meshes/if_L0/angle_10/height_0.01/include_nset_top-Y+.inp
*NSET, NSET=top-X-
*include, input=@IJES_ROOT@/meshes/if_L0/angle_10/height_0.01/include_nset_top-X-.inp
*NSET, NSET=top-Z+
*include, input=@IJES_ROOT@/meshes/if_L0/angle_10/height_0.01/include_nset_top-Z+.inp
*NSET, NSET=top-Y-
*include, input=@IJES_ROOT@/meshes/if_L0/angle_10/height_0.01/include_nset_top-Y-.inp
*NSET, NSET=top-X+
*include, input=@IJES_ROOT@/meshes/if_L0/angle_10/height_0.01/include_nset_top-X+.inp

*material, name=LinearElastic, id=linearelastic_body_1, provider=marmotmaterial
**Isotropic
**E_M    nu
 2e5, 0.3


*material, name=LinearElastic, id=linearelastic_body_2, provider=marmotmaterial
**Isotropic
**E_I    nu
 4e3, 0.3


*material, name=VONMISES, id=VonMisesInterfaceMaterial, provider = marmotmaterialhypoelasticinterface
 **Isotropic
** E_0, nu_0, h_normal, fy, H, Aexp, Hexp, MaterialID
 4e5, 0.3, 0.00984807753012208, 5, 0.1, 0.0, 0.0, 0

*section, name=section1, material=linearelastic_body_2, type=solid
bottom-body

*section, name=section2, material=linearelastic_body_1, type=solid
top-body

*section, name=section3, material=VonMisesInterfaceMaterial, type=solid
interface-body

*constraint, type=inclinedrollermpc, name=lateral-roller
nSets=bottom-X-;bottom-X+;bottom-Y-;bottom-Y+;top-X-;top-X+;top-Y-;top-Y+
field=displacement
angle=10

*job, name=InterfaceModel_job, domain=3d
*solver, solver=NISTParallel, name=theSolver

*fieldOutput
>>perNode, elSet=top-body, field=displacement, result=U, name=displacement_top
>>perNode, elSet=top-body, field=displacement, result=P, name=reaction_top
>>perNode, elSet=bottom-body, field=displacement, result=U, name=displacement_bottom
>>perNode, elSet=bottom-body, field=displacement, result=P, name=reaction_bottom
>>perNode, elSet=interface-body, field=displacement, result=U, name=displacement_interface
>>perElement, elSet=top-body, quadraturePoint=0:8, result=stress , name=stress_top, f(x)='np.mean(x,axis=1)' 
>>perElement, elSet=bottom-body, quadraturePoint=0:8, result=stress , name=stress_bottom, f(x)='np.mean(x,axis=1)' 

>>perElement, elSet=interface-body, quadraturePoint=0:4, result=generalizedForce , name=force_interface, f(x)='np.mean(x,axis=1)' 
>>perElement, elSet=interface-body, quadraturePoint=0:4, result=surfaceStressPlus , name=surface_stress_interface, f(x)='np.mean(x,axis=1)' 
>>perElement, elSet=interface-body, quadraturePoint=0:4, result=stressPlus, name=p_plus, f(x)='-np.mean(x[:,:,0]+x[:,:,1]+x[:,:,2],axis=1)/3.0'

*output, type=ensight, name=Cohesive_zone_model_interface_0.01
>>perNode, fieldOutput=displacement_interface
>>perElement, fieldOutput=force_interface
>>perElement, fieldOutput=surface_stress_interface
>>perElement, fieldOutput=p_plus
>>configuration, overwrite=yes

*output, type=ensight, name=Cohesive_zone_model_top_0.01
>>perNode, fieldOutput=displacement_top
>>perNode,  fieldOutput=reaction_top
>>perElement, fieldOutput=stress_top
>>configuration, overwrite=yes

*output, type=ensight, name=Cohesive_zone_model_bottom_0.01
>>perNode,  fieldOutput=displacement_bottom
>>perNode,  fieldOutput=reaction_bottom
>>perElement, fieldOutput=stress_bottom
>>configuration, overwrite=yes

*step, solver=theSolver
maxInc=0.05, minInc=0.00001, maxNumInc=1000, maxIter=100000, stepLength=1.0
>>options, name=theSolver, extrapolation=linear
>>dirichlet, name = bottom,   nSet = bottom-Z-,  field=displacement, 1=0., 2=0, 3=0, f(t)=t
**nodeforces, name = topF,      nSet = top-Z+,  field=displacement, 1=1e-6, 2=0, 3=0, f(t)=t
>>dirichlet, name = top,      nSet = top-Z+,  field=displacement, 1=0.00984807753012208, 2=0, 3=-0.001736481776669303, f(t)=t

*node
** Our  nodes
**
*include, input=@IJES_ROOT@/meshes/S_mesh/angle_0/height_0.06/include_nodes.inp
********************************** E L E M E N T S ****************************
*element, type=C3D8, provider=marmot, elset=bottom-body
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.06/include_elset_bottom.inp

*element, type=YIQUAD4, provider=marmot, elset=interface-body
*include, input=@IJES_ROOT@/meshes/S_mesh/angle_0/height_0.06/include_elset_interface.inp

*element, type=C3D8, provider=marmot, elset=top-body
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.06/include_elset_top.inp

********************************** N O D E S E T S **********************************
*NSET, NSET=bottom-Z+
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.06/include_nset_bottom-Z+.inp
*NSET, NSET=bottom-Y+
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.06/include_nset_bottom-Y+.inp
*NSET, NSET=bottom-X+
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.06/include_nset_bottom-X+.inp
*NSET, NSET=bottom-Z-
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.06/include_nset_bottom-Z-.inp
*NSET, NSET=bottom-Y-
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.06/include_nset_bottom-Y-.inp
*NSET, NSET=bottom-X-
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.06/include_nset_bottom-X-.inp
*NSET, NSET=top-Z-
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.06/include_nset_top-Z-.inp
*NSET, NSET=top-Y+
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.06/include_nset_top-Y+.inp
*NSET, NSET=top-X-
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.06/include_nset_top-X-.inp
*NSET, NSET=top-Z+
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.06/include_nset_top-Z+.inp
*NSET, NSET=top-Y-
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.06/include_nset_top-Y-.inp
*NSET, NSET=top-X+
*include, input=@IJES_ROOT@/meshes/L1nt20/angle_0/height_0.06/include_nset_top-X+.inp

*material, name=LinearElastic, id=linearelastic_body_1, provider=marmotmaterial
**Isotropic
** E_M, nu, density
 2e5, 0.3, 1.0


*material, name=LinearElastic, id=linearelastic_body_2, provider=marmotmaterial
**Isotropic
** E_I, nu, density
 4e3, 0.3, 1.0


*material, name=LINEARVISCOELASTICPOWERLAW, id=KelvinChainInterfaceMaterial, provider=marmotmaterialhypoelasticinterface
 **Isotropic
** E_0, nu_0, h_normal, m, n, nKelvin, minTau, timeToDays, density
 4e3, 0.3, 0.06, 5e-3, 0.3, 13, 0.0001, 1, 1.0

*section, name=section1, material=linearelastic_body_2, type=solid
bottom-body

*section, name=section2, material=linearelastic_body_1, type=solid
top-body

*section, name=section3, material=KelvinChainInterfaceMaterial, type=solid
interface-body

*job, name=InterfaceModel_job, domain=3d
*solver, solver=NISTParallel, name=theSolver

*fieldOutput
>>perElement, elSet=interface-body, quadraturePoint=0:4, result=generalizedForce, name=force_interface, f(x)='np.mean(x,axis=1)'
>>perNode, elSet=top-body, field=displacement, result=U, name=displacement_top
>>perNode, elSet=top-body, field=displacement, result=P, name=reaction_top
>>perNode, elSet=bottom-body, field=displacement, result=U, name=displacement_bottom
>>perNode, elSet=bottom-body, field=displacement, result=P, name=reaction_bottom
>>perElement, elSet=top-body, quadraturePoint=0:8, result=stress , name=stress_top, f(x)='np.mean(x,axis=1)' 
>>perElement, elSet=bottom-body, quadraturePoint=0:8, result=stress , name=stress_bottom, f(x)='np.mean(x,axis=1)' 



*output, type=ensight, name=Cohesive_zone_model_interface_0.06
>>perElement, fieldOutput=force_interface
>>configuration, overwrite=yes

*output, type=ensight, name=Cohesive_zone_model_top_0.06
>>perNode, fieldOutput=displacement_top
>>perNode,  fieldOutput=reaction_top
>>perElement, fieldOutput=stress_top
>>configuration, overwrite=yes

*output, type=ensight, name=Cohesive_zone_model_bottom_0.06
>>perNode,  fieldOutput=displacement_bottom
>>perNode,  fieldOutput=reaction_bottom
>>perElement, fieldOutput=stress_bottom
>>configuration, overwrite=yes

*step, solver=theSolver
maxInc=1, minInc=1, maxNumInc=1000, maxIter=1000, stepLength=1e-8
>>options, name=theSolver, extrapolation=linear
>>dirichlet, name = bottom, nSet = bottom-Z-, field=displacement, 1=0, 2=0, 3=0, f(t)=t
>>nodeforces, name = TopF, nSet = top-Z+, field=displacement, 1=1, f(t)=t
>>dirichlet, name = top, nSet = top-Z+, field=displacement, 2=0, 3=0, f(t)=t
>>dirichlet, name = bottom-LX,   nSet = bottom-X-,  field=displacement, 2=0, 3=0, f(t)=t
>>dirichlet, name = bottom-RX,   nSet = bottom-X+,  field=displacement, 2=0, 3=0, f(t)=t
>>dirichlet, name = bottom-FY,   nSet = bottom-Y-,  field=displacement, 2=0, 3=0, f(t)=t
>>dirichlet, name = bottom-BY,   nSet = bottom-Y+,  field=displacement, 2=0, 3=0, f(t)=t
>>dirichlet, name = top-LX,   nSet = top-X-,  field=displacement, 2=0, 3=0, f(t)=t
>>dirichlet, name = top-RX,   nSet = top-X+,  field=displacement, 2=0, 3=0, f(t)=t
>>dirichlet, name = top-FY,   nSet = top-Y-,  field=displacement, 2=0, 3=0, f(t)=t
>>dirichlet, name = top-BY,   nSet = top-Y+,  field=displacement, 2=0, 3=0, f(t)=t

*step, solver=theSolver
maxInc=0.01, minInc=0.01, maxNumInc=1000, maxIter=1000, stepLength=100
>>options, name=theSolver, extrapolation=linear
>>dirichlet, name = bottom, 1=0, 2=0, 3=0, f(t)=t
>>nodeforces, name = TopF, 1=0, f(t)=1
>>dirichlet, name = top, 2=0, 3=0, f(t)=t
>>dirichlet, name = bottom-LX, 2=0, 3=0, f(t)=t
>>dirichlet, name = bottom-RX, 2=0, 3=0, f(t)=t
>>dirichlet, name = bottom-FY, 2=0, 3=0, f(t)=t
>>dirichlet, name = bottom-BY, 2=0, 3=0, f(t)=t
>>dirichlet, name = top-LX, 2=0, 3=0, f(t)=t
>>dirichlet, name = top-RX, 2=0, 3=0, f(t)=t
>>dirichlet, name = top-FY, 2=0, 3=0, f(t)=t
>>dirichlet, name = top-BY, 2=0, 3=0, f(t)=t
